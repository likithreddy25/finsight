# Required by SEC EDGAR fair-access policy: https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="Your Name your-email@example.com"

# Where ChromaDB persists embeddings on disk
CHROMA_PERSIST_DIR=./data/chroma

# Embedding model for sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Fine-tuned scoring model (base + LoRA adapter)
BASE_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
LORA_ADAPTER_ID=likilogan/finsight-llama-lora-v1
HF_TOKEN=

# Set to "cpu", "cuda", or "mps"
MODEL_DEVICE=cpu

# Used only by eval/benchmark.py to compare against GPT-4o
OPENAI_API_KEY=

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
